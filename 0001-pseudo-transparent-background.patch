+bool
+texture_size_supported(unsigned width, unsigned height) {
+    GLint limit = 0;
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &limit);
+    return width <= (unsigned)limit && height <= (unsigned)limit;
+}
+
+static void
+screen_aligned_bg_image_rect(
+    const OSWindow *w,
+    BackgroundImageLayout layout,
+    GLfloat iwidth,
+    GLfloat iheight,
+    int wx,
+    int wy,
+    ScreenRect area,
+    GLfloat *left,
+    GLfloat *top,
+    GLfloat *right,
+    GLfloat *bottom) {
+    // The rectangle (in NDC) occupied by the image when laid out against area (in
+    // screen coordinates) instead of against the window. The calculation is in
+    // framebuffer pixels relative to the window's top left.
+    const GLfloat sx = (GLfloat)w->viewport_width / w->window_width, sy = (GLfloat)w->viewport_height / w->window_height;
+    const GLfloat area_x = (area.x - wx) * sx, area_y = (area.y - wy) * sy, area_w = area.width * sx, area_h = area.height * sy;
+    GLfloat x = area_x, y = area_y, width = area_w, height = area_h;
+    switch (layout) {
+        case TILING:
+        case MIRRORED:
+        case SCALED: break;
+        case CENTER_SCALED: {
+            const GLfloat ifrac = iwidth / iheight;
+            if (ifrac > area_w / area_h) {
+                height = area_h;
+                width = height * ifrac;
+            } else {
+                width = area_w;
+                height = width / ifrac;
+            }
+            x += (area_w - width) / 2;
+            y += (area_h - height) / 2;
+        } break;
+        case CENTER_CLAMPED:
+            width = iwidth;
+            height = iheight;
+            x += (area_w - width) / 2;
+            y += (area_h - height) / 2;
+            break;
+        case CLAMPED:
+            width = iwidth;
+            height = iheight;
+            break;
+    }
+    *left = -1.f + 2.f * x / w->viewport_width;
+    *right = -1.f + 2.f * (x + width) / w->viewport_width;
+    *top = 1.f - 2.f * y / w->viewport_height;
+    *bottom = 1.f - 2.f * (y + height) / w->viewport_height;
+}
+
+static bool
+draw_bg_image_on_monitors(
+    OSWindow *os_window, Tab *tab, const BackgroundImage *bg, BackgroundImageLayout layout, const BackgroundImageRenderSettings *s, bool is_wallpaper) {
+    // Draws the image laid out against each monitor the window overlaps (or the
+    // whole desktop), so that it appears fixed on the screen as the window moves.
+    // The desktop wallpaper already covers the whole screen, so it is drawn as is.
+    // Returns false, drawing nothing, if the window position is not known.
+    enum { MAX_MONITOR_RECTS = 16 };
+    ScreenRect rects[MAX_MONITOR_RECTS];
+    int wx, wy;
+    unsigned num_rects;
+    if (is_wallpaper) {
+        get_os_window_pos(os_window, &wx, &wy);
+        rects[0] = (ScreenRect){0, 0, bg->width, bg->height};
+        num_rects = 1;
+        layout = CLAMPED;
+    } else {
+        num_rects = get_os_window_monitor_rects(os_window, OPT(background_image_origin) == BGIMAGE_ORIGIN_DESKTOP, &wx, &wy, rects, MAX_MONITOR_RECTS);
+    }
+    if (!num_rects) return false;
+    // altough we dont use this VO we need to ensure *some* VAO is bound at this point.
+    bind_vertex_array(tab->border_rects.vao_idx);
+    if (!is_wallpaper) {
+        // fill what the image does not cover
+        bind_program(TINT_PROGRAM);
+        color_vec4_premult(program_uniform_location(TINT_PROGRAM, "tint_color"), OPT(background_image_margin_color), 1.f);
+        glUniform4f(program_uniform_location(TINT_PROGRAM, "edges"), -1, 1, 1, -1);
+        draw_quad(false, 0);
+    }
+    bind_program(BGIMAGE_PROGRAM);
+    glUniform4f(program_uniform_location(BGIMAGE_PROGRAM, "sizes"), s->os_window.width, s->os_window.height, bg->width, bg->height);
+    glUniform1f(program_uniform_location(BGIMAGE_PROGRAM, "tiled"), 0.f);
+    glUniform1i(program_uniform_location(BGIMAGE_PROGRAM, "image"), GRAPHICS_UNIT);
+    color_vec4(program_uniform_location(BGIMAGE_PROGRAM, "background"), s->bgcolor, s->opacity);
+    glActiveTexture(GL_TEXTURE0 + GRAPHICS_UNIT);
+    glBindTexture(GL_TEXTURE_2D, bg->texture_id);
+    const GLfloat sx = (GLfloat)os_window->viewport_width / os_window->window_width, sy = (GLfloat)os_window->viewport_height / os_window->window_height;
+    glEnable(GL_SCISSOR_TEST);
+    for (unsigned i = 0; i < num_rects; i++) {
+        GLfloat left, top, right, bottom;
+        screen_aligned_bg_image_rect(os_window, layout, bg->width, bg->height, wx, wy, rects[i], &left, &top, &right, &bottom);
+        glUniform4f(program_uniform_location(BGIMAGE_PROGRAM, "positions"), left, top, right, bottom);
+        // only draw on the part of the window that is on this monitor
+        const int x0 = MAX(rects[i].x, wx), x1 = MIN(rects[i].x + rects[i].width, wx + os_window->window_width);
+        const int y0 = MAX(rects[i].y, wy), y1 = MIN(rects[i].y + rects[i].height, wy + os_window->window_height);
+        const int px0 = (int)((x0 - wx) * sx + 0.5f), px1 = (int)((x1 - wx) * sx + 0.5f);
+        const int py0 = (int)((y0 - wy) * sy + 0.5f), py1 = (int)((y1 - wy) * sy + 0.5f);
+        glScissor(px0, os_window->viewport_height - py1, px1 - px0, py1 - py0);
+        draw_quad(false, 0);
+    }
+    glDisable(GL_SCISSOR_TEST);
+    unbind_program();
+    return true;
+}
