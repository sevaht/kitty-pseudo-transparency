+GLFWAPI unsigned char *
+glfwGetX11Wallpaper(int *width, int *height) {
+    // The wallpaper as 4 byte per pixel RGBA data, taken from the pixmap that the
+    // desktop's wallpaper tool leaves on the root window. It covers the whole X
+    // screen. Returns NULL if there is no wallpaper or it cannot be read. The
+    // caller must free() the data.
+    _GLFW_REQUIRE_INIT_OR_RETURN(NULL);
+    const Atom properties[] = {_glfw.x11.XROOTPMAP_ID, _glfw.x11.ESETROOT_PMAP_ID};
+    for (size_t i = 0; i < arraysz(properties); i++) {
+        unsigned char *value = NULL;
+        if (_glfwGetWindowPropertyX11(_glfw.x11.root, properties[i], XA_PIXMAP, &value) != 1 || !value) {
+            if (value) XFree(value);
+            continue;
+        }
+        const Pixmap pixmap = *(Pixmap *)value;
+        XFree(value);
+        // the wallpaper tool may have freed the pixmap, in which case X reports an error
+        Window root;
+        int x, y;
+        unsigned w, h, border, depth;
+        _glfwGrabErrorHandlerX11();
+        const Status ok = XGetGeometry(_glfw.x11.display, pixmap, &root, &x, &y, &w, &h, &border, &depth);
+        XImage *image = ok && w && h ? XGetImage(_glfw.x11.display, pixmap, 0, 0, w, h, AllPlanes, ZPixmap) : NULL;
+        _glfwReleaseErrorHandlerX11();
+        if (!image) continue;
+        unsigned char *ans = NULL;
+        // images of pixmaps carry no channel masks, those of the screen's visual apply
+        const Visual *visual = DefaultVisual(_glfw.x11.display, _glfw.x11.screen);
+        const unsigned long masks[3] = {
+            image->red_mask ? image->red_mask : visual->red_mask,
+            image->green_mask ? image->green_mask : visual->green_mask,
+            image->blue_mask ? image->blue_mask : visual->blue_mask};
+        // only the usual 8 bits per channel layouts are supported
+        if (_glfw.x11.errorCode == Success && image->bits_per_pixel == 32 && masks[0] && masks[1] && masks[2] && (ans = malloc((size_t)w * h * 4))) {
+            unsigned shifts[3];
+            for (int c = 0; c < 3; c++) {
+                shifts[c] = 0;
+                while (!((masks[c] >> shifts[c]) & 1)) shifts[c]++;
+            }
+            unsigned char *out = ans;
+            for (unsigned row = 0; row < h; row++) {
+                for (unsigned col = 0; col < w; col++) {
+                    const unsigned long pixel = XGetPixel(image, col, row);
+                    *out++ = (pixel & masks[0]) >> shifts[0];
+                    *out++ = (pixel & masks[1]) >> shifts[1];
+                    *out++ = (pixel & masks[2]) >> shifts[2];
+                    *out++ = 0xff;
+                }
+            }
+            *width = w;
+            *height = h;
+        }
+        XDestroyImage(image);
+        if (ans) return ans;
+    }
+    return NULL;
+}
+
+GLFWAPI void
+glfwSetX11WallpaperChangeCallback(void (*callback)(void)) {
+    _GLFW_REQUIRE_INIT();
+    _glfw.x11.wallpaper_change_callback = callback;
+}
