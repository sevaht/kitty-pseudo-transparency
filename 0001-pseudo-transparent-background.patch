+    // a background image laid out against the screen has to follow the window
+    if (OPT(background_image_origin) != BGIMAGE_ORIGIN_WINDOW) {
+        global_state.callback_os_window->needs_render = true;
+        request_tick_callback();
+    }
 #ifdef __APPLE__
     // Apple needs IME position to be accurate before the next key event
     OSWindow *osw = global_state.callback_os_window;
@@ -1714,6 +1729,39 @@ set_os_window_pos(OSWindow *os_window, int x, int y) {
     glfwSetWindowPos(os_window->handle, x, y);
 }
 
+unsigned
+get_os_window_monitor_rects(OSWindow *os_window, bool whole_desktop, int *window_x, int *window_y, ScreenRect *rects, unsigned capacity) {
+    // The window position and the rectangles, in screen coordinates, of each
+    // monitor the window overlaps (or the bounding box of all monitors). Returns
+    // the number of rectangles, zero when the window position is unknown, as on
+    // Wayland.
+    if (global_state.is_wayland || os_window->window_width <= 0 || os_window->window_height <= 0 || !capacity) return 0;
+    int count = 0;
+    GLFWmonitor **monitors = glfwGetMonitors(&count);
+    if (count <= 0 || !monitors) return 0;
+    glfwGetWindowPos(os_window->handle, window_x, window_y);
+    unsigned num = 0;
+    int left = INT_MAX, top = INT_MAX, right = INT_MIN, bottom = INT_MIN;
+    for (int i = 0; i < count; i++) {
+        const GLFWvidmode *mode = glfwGetVideoMode(monitors[i]);
+        if (!mode) continue;
+        int mx, my;
+        glfwGetMonitorPos(monitors[i], &mx, &my);
+        if (whole_desktop) {
+            left = MIN(left, mx);
+            top = MIN(top, my);
+            right = MAX(right, mx + mode->width);
+            bottom = MAX(bottom, my + mode->height);
+            continue;
+        }
+        const bool overlaps = mx < *window_x + os_window->window_width && *window_x < mx + mode->width && my < *window_y + os_window->window_height &&
+                              *window_y < my + mode->height;
+        if (overlaps && num < capacity) rects[num++] = (ScreenRect){mx, my, mode->width, mode->height};
+    }
+    if (whole_desktop && right > left && bottom > top) rects[num++] = (ScreenRect){left, top, right - left, bottom - top};
+    return num;
+}
