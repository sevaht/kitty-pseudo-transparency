diff --git a/kitty/state.c b/kitty/state.c
index da1b97dc3..3f580fd17 100644
--- a/kitty/state.c
+++ b/kitty/state.c
@@ -281,9 +281,47 @@ global_background_image(size_t idx) {
     return global_state.background_images.count > idx ? global_state.background_images.images[idx] : NULL;
 }
 
+static BackgroundImage *
+desktop_wallpaper(void) {
+    // The wallpaper of the X11 root window as a background image. It is read
+    // on first use and again after it changes. If it cannot be read, the
+    // previous wallpaper, if any, stays in use.
+    if (global_state.wallpaper.valid) return global_state.wallpaper.image;
+    global_state.wallpaper.valid = true;
+    int width = 0, height = 0;
+    uint8_t *bitmap = global_state.is_wayland || !glfwGetX11Wallpaper ? NULL : glfwGetX11Wallpaper(&width, &height);
+    if (!bitmap) {
+        if (!global_state.wallpaper.image)
+            log_error("Could not read the desktop wallpaper, background_image_origin wallpaper needs X11 and a wallpaper set on the root window");
+        return global_state.wallpaper.image;
+    }
+    BackgroundImage *img = NULL;
+    if (texture_size_supported(width, height)) img = calloc(1, sizeof(BackgroundImage));
+    else log_error("The wallpaper is too large to be used as a texture: %dx%d", width, height);
+    if (img) {
+        img->bitmap = bitmap;
+        img->width = width;
+        img->height = height;
+        img->id = ++bg_image_id_counter;
+        if (send_bgimage_to_gpu(CLAMPED, img)) {
+            img->refcnt = 1;
+            free_bgimage(&global_state.wallpaper.image, true);
+            global_state.wallpaper.image = img;
+        } else {
+            free_bgimage_bitmap(img);
+            free(img);
+        }
+    } else free(bitmap);
+    return global_state.wallpaper.image;
+}
+
 BackgroundImage *
 background_image_for_os_window(OSWindow *w) {
     if (w->background_image.no_image) return NULL;
+    if (OPT(background_image_origin) == BGIMAGE_ORIGIN_WALLPAPER) {
+        BackgroundImage *wallpaper = desktop_wallpaper();
+        if (wallpaper) return wallpaper;
+    }
     if (w->background_image.override) return w->background_image.override;
     BackgroundImage *ans = NULL;
     if (w->background_image.global_bg_images_idx && (ans = global_background_image(w->background_image.global_bg_images_idx))) return ans;
